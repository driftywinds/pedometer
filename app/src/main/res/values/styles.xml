<resources>

    <!-- Base application theme: Material 3 light. The dark variant is declared in
         values-night/styles.xml (Material 1.11 does not provide DayNight theme variants). -->
    <style name="AppTheme" parent="Theme.Material3.Light">
        <item name="secusoLogoDrawable">@drawable/secuso_logo_black</item>

        <!-- Material 3 color roles. On Android 12+, dynamic color can replace these with
             colors derived from the user's wallpaper (see PFAPedometerApplication). -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>

        <!-- Legacy AppCompat roles, still used by a few widgets and by the app code. -->
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/m3_secondary</item>

        <item name="android:alertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
    </style>

    <!-- Dialog themes -->
    <style name="AppTheme.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorAccent">@color/m3_secondary</item>
    </style>

    <style name="AppTheme.DatePickerDialog" parent="AppTheme.Dialog" />

    <style name="AppTheme.AlertDialog" parent="AppTheme.Dialog" />

    <style name="AppTheme.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Typography for report cards -->
    <style name="CardViewPrimaryTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CardViewSubTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CardViewBody">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_margin">16dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="SimpleImageButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Toolbar overlays. The app bar is surface colored in both themes. -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="PreferencesTheme" parent="AppTheme" />

    <style name="SplashTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
